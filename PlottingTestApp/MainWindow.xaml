<Window
    x:Class="PlottingTestApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="clr-namespace:ModernThemables.Charting.Controls;assembly=ModernThemables.Charting"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PlottingTestApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <charts:CartesianChart
            x:Name="LineChart"
            Background="White"
            Cursor="Cross"
            FontSize="9.75"
            Foreground="Black"
            ShowXSeparatorLines="True"
            ShowYSeparatorLines="True"
            TooltipOpacity="0.9" />
    </Grid>
</Window>
