<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="Black" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#1e1e1e" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="DarkGray" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#282828" />
    <SolidColorBrush x:Key="PrimaryControlBrush" Color="#8c8c8c" />
    <SolidColorBrush x:Key="SecondaryControlBrush" Color="#505050" />
    <SolidColorBrush x:Key="ThemeBrush" Color="#2f2f4a" />
    <SolidColorBrush x:Key="ThemeTextBrush" Color="White" />

    <SolidColorBrush x:Key="PrimaryControlMouseOverBrush" Color="#969696" />
    <SolidColorBrush x:Key="SecondaryControlMouseOverBrush" Color="Gray" />
    <SolidColorBrush x:Key="ThemeMouseOverBrush" Color="#3d3d5f" />

    <SolidColorBrush x:Key="PrimaryControlMouseDownBrush" Color="#646464" />
    <SolidColorBrush x:Key="SecondaryControlMouseDownBrush" Color="Gray" />
    <SolidColorBrush x:Key="ThemeMouseDownBrush" Color="#2f2f4a" />

    <SolidColorBrush x:Key="PrimaryControlBorderBrush" Color="LightGray" />
    <SolidColorBrush x:Key="SecondaryControlBorderBrush" Color="Gray" />
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="DeepSkyBlue" />

    <SolidColorBrush x:Key="PrimaryControlDisabledBrush" Color="#282828" />
    <SolidColorBrush x:Key="SecondaryControlDisabledBrush" Color="#3c3c3c" />
    <SolidColorBrush x:Key="ThemeDisabledBrush" Color="DeepSkyBlue" />


</ResourceDictionary>
