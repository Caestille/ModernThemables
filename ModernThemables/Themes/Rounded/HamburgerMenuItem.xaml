<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ModernThemables.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scalableicons="clr-namespace:ModernThemables.Icons;assembly=ModernThemables.Icons"
    mc:Ignorable="d">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ModernThemables;component/Themes/Rounded/Button2.xaml" />
        <ResourceDictionary Source="pack://application:,,,/ModernThemables;component/Themes/Rounded/FocusStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/ModernThemables;component/Themes/Colours.xaml" />
        <ResourceDictionary Source="pack://application:,,,/ModernThemables;component/Themes/Rounded/InfoTooltipHorizontal.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style
        x:Key="MenuItemButtonStyle"
        BasedOn="{StaticResource ResourceKey={x:Type controls:Button2}}"
        TargetType="{x:Type controls:Button2}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="{Binding RelativeSource={RelativeSource Self}, Path=Width}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <ControlTemplate x:Key="RoundedHamburgerMenuItemControlTemplate" TargetType="{x:Type controls:HamburgerMenuItem}">
        <Grid Margin="0,3,0,0">
            <StackPanel>
                <Grid x:Name="SingleItemGrid">
                    <Border>
                        <controls:Button2
                            Width="Auto"
                            Height="Auto"
                            MinHeight="40"
                            Padding="0"
                            HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                            VerticalAlignment="Top"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding InternalSelectCommand, RelativeSource={RelativeSource TemplatedParent}}"
                            CornerRadius="5"
                            Foreground="{TemplateBinding Foreground}"
                            MouseDownBrush="{TemplateBinding MouseDownBrush}"
                            MouseOverBrush="{TemplateBinding MouseOverBrush}">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Grid.RowSpan="2"
                                    Grid.Column="1"
                                    Width="25"
                                    Height="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Stretch"
                                    Content="{TemplateBinding Icon}"
                                    ContentTemplate="{Binding IconTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                    Focusable="False"
                                    IsHitTestVisible="False">
                                    <ContentControl.Visibility>
                                        <MultiBinding Converter="{StaticResource MultiBoolOrToVisibilityConverter}">
                                            <Binding
                                                Converter="{StaticResource IsNotNullConverter}"
                                                Path="IconTemplate"
                                                RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="ReserveIconSpace" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </ContentControl.Visibility>
                                </ContentControl>
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ContentControl
                                        Margin="10,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Content="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}"
                                        ContentTemplate="{Binding TitleTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                        IsHitTestVisible="False">
                                        <ContentControl.Visibility>
                                            <MultiBinding Converter="{StaticResource MultiBoolAndToVisibilityConverter}">
                                                <Binding Path="IsContainingMenuOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding
                                                    Converter="{StaticResource IsNotNullConverter}"
                                                    Path="TitleTemplate"
                                                    RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </ContentControl.Visibility>
                                    </ContentControl>
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource MultiBoolAndToVisibilityConverter}">
                                                <Binding Path="IsContainingMenuOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding
                                                    Converter="{StaticResource IsNullConverter}"
                                                    Path="TitleTemplate"
                                                    RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <TextBlock.Style>
                                            <Style>
                                                <Setter Property="TextBlock.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                        <Setter Property="TextBlock.FontWeight" Value="SemiBold" />
                                                        <Setter Property="TextBlock.FontSize" Value="14" />
                                                        <Setter Property="TextBlock.Foreground" Value="{Binding SelectedForeground, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ContentControl
                                        Grid.Row="1"
                                        Margin="10,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Content="{Binding SubTitle, RelativeSource={RelativeSource TemplatedParent}}"
                                        ContentTemplate="{Binding SubTitleTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                        IsHitTestVisible="False">
                                        <ContentControl.Visibility>
                                            <MultiBinding Converter="{StaticResource MultiBoolAndToVisibilityConverter}">
                                                <Binding Path="IsContainingMenuOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding
                                                    Converter="{StaticResource IsNotNullConverter}"
                                                    Path="SubTitleTemplate"
                                                    RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </ContentControl.Visibility>
                                    </ContentControl>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="10,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Foreground="{TemplateBinding SubtitleForeground}"
                                        IsHitTestVisible="False"
                                        Text="{Binding SubTitle, RelativeSource={RelativeSource TemplatedParent}}"
                                        TextWrapping="Wrap">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource MultiBoolAndToVisibilityConverter}">
                                                <Binding Path="IsContainingMenuOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding
                                                    Converter="{StaticResource StringNotEmptyConverter}"
                                                    Path="SubTitle"
                                                    RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding
                                                    Converter="{StaticResource IsNullConverter}"
                                                    Path="SubTitleTemplate"
                                                    RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                </Grid>
                                <Grid
                                    Grid.Column="3"
                                    Margin="0,0,13,0"
                                    VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!--#region Add child button-->
                                    <controls:Button2
                                        Background="Transparent"
                                        Command="{Binding AddChildCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        Style="{StaticResource MenuItemButtonStyle}"
                                        ToolTip="Add">
                                        <controls:Button2.Visibility>
                                            <MultiBinding Converter="{StaticResource MultiBoolAndToVisibilityConverter}">
                                                <Binding Path="CanAddChild" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="IsContainingMenuOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding ElementName="SingleItemGrid" Path="IsMouseOver" />
                                            </MultiBinding>
                                        </controls:Button2.Visibility>
                                        <scalableicons:Icon
                                            Width="10"
                                            Height="10"
                                            Margin="2"
                                            Kind="Plus" />
                                    </controls:Button2>
                                    <!--#endregion-->
                                    <!--#region Delete button-->
                                    <controls:Button2
                                        Grid.Column="1"
                                        Command="{Binding DeleteCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        Style="{StaticResource MenuItemButtonStyle}"
                                        ToolTip="Delete">
                                        <controls:Button2.Visibility>
                                            <MultiBinding Converter="{StaticResource MultiBoolAndToVisibilityConverter}">
                                                <Binding Path="CanDelete" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="IsContainingMenuOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding ElementName="SingleItemGrid" Path="IsMouseOver" />
                                            </MultiBinding>
                                        </controls:Button2.Visibility>
                                        <scalableicons:Icon
                                            Width="10"
                                            Height="10"
                                            Margin="1,0,0,0"
                                            Kind="Bin" />
                                    </controls:Button2>
                                    <!--#endregion-->
                                    <!--#region Drop down indicator-->
                                    <Grid
                                        Grid.Column="2"
                                        Width="10"
                                        Height="10"
                                        Margin="3,0,0,0"
                                        HorizontalAlignment="Right"
                                        IsHitTestVisible="False"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Grid.Visibility>
                                            <MultiBinding Converter="{StaticResource MultiBoolAndToVisibilityConverter}">
                                                <Binding Converter="{StaticResource SequenceHasElementsBooleanConverter}" Path="ChildViewModels" />
                                                <Binding Path="IsContainingMenuOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="CanOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </Grid.Visibility>
                                        <Grid.Style>
                                            <Style>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                        <Setter Property="Grid.RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="180" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <scalableicons:Icon Foreground="{TemplateBinding Foreground}" Kind="Expand" />
                                    </Grid>
                                    <!--#endregion-->
                                </Grid>
                            </Grid>
                        </controls:Button2>
                        <Border.Style>
                            <Style>
                                <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
                            </Style>
                        </Border.Style>
                        <Border.ToolTip>
                            <ToolTip Style="{StaticResource InfoTooltipHorizontal}" Visibility="{Binding IsContainingMenuOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibleIfFalseConverter}}">
                                <TextBlock FontSize="17" Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" />
                            </ToolTip>
                        </Border.ToolTip>
                    </Border>
                    <Border
                        Height="1"
                        Margin="15,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Background="{TemplateBinding Foreground}"
                        IsHitTestVisible="False"
                        Opacity="0.3"
                        Visibility="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibleIfTrueConverter}}" />
                </Grid>
                <Grid Visibility="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibleIfTrueConverter}}">
                    <ItemsControl
                        VerticalAlignment="Bottom"
                        ItemTemplate="{Binding ChildItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                        ItemsSource="{Binding ChildItems, RelativeSource={RelativeSource TemplatedParent}}" />
                </Grid>
            </StackPanel>
            <Border
                Width="3"
                Margin="-4,10"
                HorizontalAlignment="Left"
                Background="{TemplateBinding AccentBrush}"
                CornerRadius="1.5">
                <Border.Visibility>
                    <MultiBinding Converter="{StaticResource MultiBoolAndToVisibilityConverter}">
                        <Binding Path="IsOpen" RelativeSource="{RelativeSource TemplatedParent}" />
                        <Binding Path="ShowOpenIndicator" RelativeSource="{RelativeSource TemplatedParent}" />
                    </MultiBinding>
                </Border.Visibility>
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type controls:HamburgerMenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="AccentBrush" Value="{DynamicResource ThemeMouseDownBrush}" />
        <Setter Property="SelectedForeground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="SubtitleForeground" Value="{DynamicResource TertiaryTextBrush}" />
        <Setter Property="MouseOverBrush">
            <Setter.Value>
                <SolidColorBrush Opacity="0.2" Color="White" />
            </Setter.Value>
        </Setter>
        <Setter Property="MouseDownBrush">
            <Setter.Value>
                <SolidColorBrush Opacity="0.2" Color="Black" />
            </Setter.Value>
        </Setter>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusStyle}" />
        <Setter Property="Template" Value="{StaticResource RoundedHamburgerMenuItemControlTemplate}" />
    </Style>

</ResourceDictionary>